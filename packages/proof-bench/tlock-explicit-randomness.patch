+/// Blindfold feasibility adapter: wrap a file key with explicit private randomness.
+pub fn encrypt_with_sigma(public_key: &[u8], round: u64, key: [u8;16], sigma: [u8;16]) -> anyhow::Result<Vec<u8>> {
+    let id = sha2::Sha256::digest(round.to_be_bytes());
+    let ct = ibe::encrypt_with_sigma(GAffine::try_from(public_key)?, id, key, sigma)?;
+    let mut out = ct.u.to_compressed()?;
+    out.extend(ct.v);
+    out.extend(ct.w);
+    Ok(out)
+}
