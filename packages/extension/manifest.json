{
  "manifest_version": 3,
  "name": "Blindfold",
  "version": "0.1.0",
  "description": "Seals Blindfold orders, proves admission and keeps private trading state. Your wallet only signs.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "offscreen", "nativeMessaging", "unlimitedStorage"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "Blindfold" },
  "externally_connectable": { "matches": ["http://localhost:4317/*"] },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
